import tkinter as tk
from datetime import datetime


class TraceFrontend:
    def __init__(self, root):
        self.root = root
        self.root.title("Tracing Module - Frontend")

        self.create_widgets()
        self.bind_events()

    def create_widgets(self):
        self.label = tk.Label(self.root, text="Enter text:")
        self.label.pack(pady=5)

        self.entry = tk.Entry(self.root, width=40)
        self.entry.pack(pady=5)

        self.button = tk.Button(self.root, text="Submit")
        self.button.pack(pady=5)

        self.trace_box = tk.Text(self.root, height=12, width=60)
        self.trace_box.pack(pady=10)

        self.trace("UI initialized")

    def bind_events(self):
        self.entry.bind("<KeyPress>", self.on_key_press)
        self.button.bind("<Button-1>", self.on_button_click)
        self.root.bind("<FocusIn>", self.on_focus)

    # ---------- Event Handlers ----------
    def on_key_press(self, event):
        self.trace(f"Key pressed: '{event.char}'")

    def on_button_click(self, event):
        value = self.entry.get()
        self.trace(f"Button clicked | Input value: '{value}'")

    def on_focus(self, event):
        self.trace("Window focused")

    # ---------- Tracing ----------
    def trace(self, message):
        timestamp = datetime.now().strftime("%H:%M:%S")
        log = f"[{timestamp}] {message}\n"
        self.trace_box.insert(tk.END, log)
        self.trace_box.see(tk.END)


if __name__ == "__main__":
    root = tk.Tk()
    app = TraceFrontend(root)
    root.mainloop()
